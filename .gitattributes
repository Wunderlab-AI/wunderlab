# Normalize line endings: LF in the repo and in checkouts
* text=auto eol=lf

# Scripts that must keep their line endings
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.gguf binary
*.safetensors binary

# GitHub language statistics
*.cu linguist-language=Cuda
*.cuh linguist-language=Cuda
*.cl linguist-language=OpenCL
third_party/** linguist-vendored
docs/** linguist-documentation

# Large files via Git LFS (uncomment after `git lfs install`)
#*.gguf filter=lfs diff=lfs merge=lfs -text
